<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key><string>English</string>
	<key>CFBundleGetInfoString</key><string>Codeless: merges the OSString "acpi-path" into the RTX 5090 Laptop PCI nub (10de:2c58), which A2XACPIPCI does not publish. NVRM needs it to find its ACPI node (NBCI _DSM backlight table) - same as on Tahoe.</string>
	<key>CFBundleIdentifier</key><string>local.scar27.GPUAcpiPathInjector</string>
	<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
	<key>CFBundleName</key><string>GPUAcpiPathInjector</string>
	<key>CFBundlePackageType</key><string>KEXT</string>
	<key>CFBundleShortVersionString</key><string>1.0.0</string>
	<key>CFBundleSignature</key><string>????</string>
	<key>CFBundleVersion</key><string>1.0.0</string>
	<key>IOKitPersonalities</key>
	<dict>
		<key>GPU acpi-path</key>
		<dict>
			<key>CFBundleIdentifier</key><string>com.apple.driver.AppleUSBHostMergeProperties</string>
			<key>IOClass</key><string>AppleUSBHostMergeProperties</string>
			<key>IOProviderClass</key><string>IOPCIDevice</string>
			<key>IOPCIMatch</key><string>0x2c5810de</string>
			<key>IOMatchCategory</key><string>GPUAcpiPathInjector</string>
			<key>IOProbeScore</key><integer>20000</integer>
			<key>IOProviderMergeProperties</key>
			<dict><key>acpi-path</key><string>IOACPIPlane:/_SB_/PC00@0/RP01@60000/PXSX@0</string></dict>
		</dict>
	</dict>
	<key>OSBundleRequired</key><string>Root</string>
</dict>
</plist>
